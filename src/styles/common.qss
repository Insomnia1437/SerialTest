/* Title bar and Dock Back button */
#dockTitleBar {
    min-height: 32px;
}

#dockTitleLabel {
    font-weight: bold;
}

#dockBackButton {
    border: none;
    border-radius: 4px;
    padding: 4px 10px;
    font-weight: bold;
}

/* Dock tabs in QMainWindow */
QMainWindow#MainWindow QTabBar::tab:top {
    min-height: 24px;
    min-width: 90px;
    padding: 8px 18px;
    border: none;
    border-bottom: 3px solid transparent;
    font-weight: bold;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    width: 10px;
}

QScrollBar::handle:vertical {
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    border: none;
    height: 10px;
}

QScrollBar::handle:horizontal {
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}

/* Unified control dimensions (height ~32-36px with default font, radius 5px) */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    min-height: 24px;
    border-radius: 5px;
    padding: 3px 8px;
    border-width: 1px;
    border-style: solid;
}

QPushButton {
    min-height: 24px;
    border-radius: 5px;
    padding: 3px 14px;
    border-width: 1px;
    border-style: solid;
    font-weight: bold;
}

/* Prevent inner line edits from duplicating border/padding */
QComboBox QLineEdit, QAbstractSpinBox QLineEdit {
    border: none;
    background: transparent;
    padding: 0px;
    margin: 0px;
}

/* ComboBox dropdown button & arrow */
QComboBox {
    padding-right: 24px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid transparent;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

/* SpinBox buttons & arrows */
QAbstractSpinBox {
    padding-right: 20px;
}

QAbstractSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border-bottom: 1px solid transparent;
}

QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
}

QAbstractSpinBox::up-arrow, QAbstractSpinBox::down-arrow {
    width: 10px;
    height: 10px;
}

/* Splitters */
QSplitter::handle:horizontal {
    width: 6px;
}

QSplitter::handle:vertical {
    height: 6px;
}

/* GroupBox margin relative to font size for high-DPI / custom fonts */
QGroupBox {
    margin-top: 1.4em;
    padding-top: 0.4em;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
}

/* ControlItem name editor */
QLineEdit#nameEdit {
    background-color: transparent;
    border-color: transparent;
}


