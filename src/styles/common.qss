#dockTitleBar {
    min-height: 32px;
}

#dockTitleLabel {
    font-weight: bold;
    font-size: 12px;
}

#dockBackButton {
    border: none;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: bold;
}

QTabBar::tab {
    padding: 10px 24px;
    min-width: 90px;
    border: none;
    font-size: 12px;
    font-weight: bold;
}

QScrollBar:vertical {
    border: none;
    width: 10px;
}

QScrollBar::handle:vertical {
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    border: none;
    height: 10px;
}

QScrollBar::handle:horizontal {
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
}

QPushButton {
    border-radius: 6px;
    padding: 6px 16px;
    font-weight: bold;
    font-size: 12px;
}
