QMainWindow {
    background-color: #f3f3f5;
}

QDockWidget {
    border: 1px solid #d0d0d5;
}

#dockTitleBar {
    background-color: #e8e8ec;
    border-bottom: 1px solid #d0d0d5;
}

#dockTitleLabel {
    color: #202020;
}

#dockBackButton {
    background-color: #007acc;
    color: #ffffff;
}

#dockBackButton:hover {
    background-color: #0098ff;
}

#dockBackButton:pressed {
    background-color: #005a9e;
}

/* QMainWindow Dock tabs */
QMainWindow#MainWindow QTabBar {
    background-color: #f3f3f5;
}

QMainWindow#MainWindow QTabBar::tab:top {
    background-color: #e8e8ec;
    color: #606065;
    border-bottom: 3px solid transparent;
}

QMainWindow#MainWindow QTabBar::tab:top:selected {
    background-color: #f3f3f5;
    color: #007acc;
    border-bottom: 3px solid #007acc;
}

QMainWindow#MainWindow QTabBar::tab:top:hover:!selected {
    background-color: #dddde2;
    color: #202025;
    border-bottom: 3px solid transparent;
}

/* ScrollBars */
QScrollBar:vertical, QScrollBar:horizontal {
    background: #f3f3f5;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #c0c0c5;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #a8a8ad;
}

/* Controls */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    color: #202020;
    border-color: #c0c0c5;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #007acc;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #f9f9f9;
    color: #a0a0a5;
    border-color: #e0e0e5;
}

/* ComboBox dropdown */
QComboBox::drop-down {
    background-color: transparent;
}

QComboBox::down-arrow {
    image: url(":/qss_icons/light/rc/arrow_down.png");
}

QComboBox::down-arrow:disabled {
    image: url(":/qss_icons/light/rc/arrow_down_disabled.png");
}

/* SpinBox arrows */
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    background-color: transparent;
}

QAbstractSpinBox::up-arrow {
    image: url(":/qss_icons/light/rc/arrow_up.png");
}

QAbstractSpinBox::up-arrow:disabled {
    image: url(":/qss_icons/light/rc/arrow_up_disabled.png");
}

QAbstractSpinBox::down-arrow {
    image: url(":/qss_icons/light/rc/arrow_down.png");
}

QAbstractSpinBox::down-arrow:disabled {
    image: url(":/qss_icons/light/rc/arrow_down_disabled.png");
}

/* Buttons */
QPushButton {
    background-color: #ffffff;
    color: #202020;
    border-color: #c0c0c5;
}

QPushButton:hover {
    background-color: #f0f0f5;
    border-color: #007acc;
}

QPushButton:pressed {
    background-color: #e0e0e5;
}

QPushButton:disabled {
    color: #a0a0a5;
    background-color: #f9f9f9;
    border-color: #e0e0e5;
}

/* Splitter */
QSplitter::handle {
    background-color: #d8d8dd;
}

QSplitter::handle:hover {
    background-color: #007acc;
}

/* ControlItem name editor */
QLineEdit#nameEdit {
    background-color: transparent;
    border-color: transparent;
}

QLineEdit#nameEdit:hover {
    border-color: #c0c0c5;
}

QLineEdit#nameEdit:focus {
    background-color: #ffffff;
    border-color: #007acc;
}

